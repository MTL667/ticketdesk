# ClickUp Configuration
CLICKUP_API_TOKEN=your_clickup_api_token_here
CLICKUP_LIST_ID=your_clickup_list_id_here

# Azure AD / Microsoft Entra ID Configuration
AZURE_AD_CLIENT_ID=your_azure_ad_client_id
AZURE_AD_CLIENT_SECRET=your_azure_ad_client_secret
AZURE_AD_TENANT_ID=common
ALLOWED_TENANTS=11111111-1111-1111-1111-111111111111,22222222-2222-2222-2222-222222222222

# NextAuth Configuration
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ticketdesk

# Authorization allowlists (comma-separated emails, case-insensitive)
ADMIN_EMAILS=admin@example.com
MARKETING_USERS=marketing@example.com

# SendGrid (ticket comment mail + BookAVan approval notifications)
# If unset, BookAVan create/approve/reject still works; emails are skipped.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=servicedesk@spoq.be
SENDGRID_FROM_NAME=ServiceDesk

# Cronicle Scheduled Sync
CRON_SECRET=your_cron_secret_here

# Application URL
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# S3-compatible object storage (Marketing Inventaris photos — Epic 4)
S3_ENDPOINT=https://s3.example.com
S3_REGION=eu-west-1
S3_BUCKET=ticketdesk
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
S3_PUBLIC_URL=https://s3.example.com/ticketdesk
